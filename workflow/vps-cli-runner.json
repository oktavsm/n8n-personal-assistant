          }
        }
      },
      {
        "parameters": {
          "resource": "command",
          "operation": "execute",
          "authentication": "privateKey",
          "command": "={{ \"/home/dev/.local/bin/run-agent.sh \" + JSON.stringify($json.prompt) }}"
        },
        "type": "n8n-nodes-base.ssh",
        "typeVersion": 1,
