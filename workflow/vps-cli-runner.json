        "id": "8280ed4e-ef9e-405c-8972-c33731303f73",
        "name": "vps-trigger"
      },
      {
        "parameters": {
          "jsCode": "const item = $input.first().json;\nconst data = item.body?.data || item.data || item;\nconst msg = data.message || {};\nconst remoteJid = data.key?.remoteJid || '';\nconst participant = data.key?.participant || data.key?.participantAlt || remoteJid;\nconst messageId = data.key?.id || '';\n\nconst text = (msg.conversation || msg.extendedTextMessage?.text || '').trim();\nconst prompt = text.replace(/^(\\/vps|\\/agent)\\s*/i, '').trim();\n\nreturn [{\n  json: {\n    remoteJid,\n    participant,\n    messageId,\n    rawText: text,\n    prompt: prompt || 'Cek status VPS, disk, dan container docker secara ringkas'\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -380,
          0
        ],
        "id": "d4f3a7a7-30e1-48bb-a700-65c7e6fe0379",
        "name": "Normalize & Extract Task"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://evolution-api:8080/message/sendText/okta_wa",
          "authentication": "genericCredentialType",
          "genericAuthType": "=httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "number",
                "value": "={{ $json.remoteJid }}"
              },
              {
                "name": "text",
                "value": "={{ '⏳ *VPS Agent Task Diterima*\\n\\n📋 *Instruksi:* \"' + $json.prompt + '\"\\n\\n_Codex Agent sedang mengeksekusi instruksi di VPS..._' }}"
              }
            ]
          },
          "options": {}
        },
