        "id": "c01824ab-0101-447a-8fbb-91bc3501a001",
        "name": "Error Trigger"
      },
      {
        "parameters": {
          "jsCode": "const err = $input.first().json;\nconst wf = err.workflow || {};\nconst exec = err.execution || {};\nconst errorObj = exec.error || {};\n\nconst wfName = wf.name || 'Unknown Workflow';\nconst wfId = wf.id || '-';\nconst execId = exec.id || '-';\nconst lastNode = exec.lastNodeExecuted || '-';\nconst errorMessage = errorObj.message || 'Tidak ada pesan error spesifik.';\nconst execUrl = exec.url || `https://oktaavsm.bccdev.id/n8n/execution/${execId}`;\n\nconst timeStr = new Date().toLocaleString('id-ID', {\n  timeZone: 'Asia/Jakarta',\n  dateStyle: 'full',\n  timeStyle: 'medium',\n});\n\nconst message = `🚨 *ALERT: WORKFLOW ERROR TERDETEKSI!*\n\n📌 *Workflow:* ${wfName}\n🆔 *ID:* \\`${wfId}\\`\n⚙️ *Node Error:* \\`${lastNode}\\`\n🕒 *Waktu:* ${timeStr} WIB\n\n❌ *Detail Error:*\n${errorMessage}\n\n🔗 *Link Investigasi Eksekusi:*\n${execUrl}\n\n_Pesan ini dikirim otomatis oleh n8n Error Trigger._`;\n\nreturn [{\n  json: {\n    message,\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          450,
          300
        ],
        "id": "c01824ab-0101-447a-8fbb-91bc3501a002",
        "name": "Format Error Message"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://evolution-api:8080/message/sendText/okta_wa",
          "authentication": "genericCredentialType",
          "genericAuthType": "=httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "number",
                "value": "={{ $env.MY_WA_NUMBER }}"
              },
              {
                "name": "text",
                "value": "={{ $json.message }}"
              }
            ]
          },
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
