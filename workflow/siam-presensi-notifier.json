      {
        "parameters": {
          "method": "POST",
          "url": "http://evolution-api:8080/message/sendText/okta_wa",
          "authentication": "genericCredentialType",
          "genericAuthType": "=httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "number",
                "value": "={{ (() => { try { return $('WA Command').item.json.body.data.key.remoteJid; } catch(e) { return \"\"; } })() }}"
              },
              {
                "name": "text",
                "value": "=✅ Presensi untuk mata kuliah *{{ $('Cek').item.json.nama_matkul }}* berhasil dieksekusi ke SIAM."
              }
            ]
          },
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          1744,
          240
        ],
        "id": "77c7e47d-94ec-40f8-9844-0b893cb64116",
        "name": "[HTTP Whatsapp]2",
        "credentials": {
          "httpHeaderAuth": {
            "id": "GEmHpHffIDZKhtvn",
            "name": "Header Auth account"
          }
        },
        "retryOnFail": true,
        "maxTries": 2,
        "waitBetweenTries": 1000
      },
      {
        "parameters": {
          "jsCode": "// ==============================\n// CONFIG\n// ==============================\n\n// ==============================\n// HELPER\n// ==============================\nfunction getWAData() {\n  try {\n    const data = $(\"WA Command\").item.json.body.data;\n\n    const text =\n      data?.message?.conversation ||\n      data?.message?.extendedTextMessage?.text ||\n      \"\";\n\n    const remoteJid = data?.key?.remoteJid || \"\";\n\n    return {\n      isScheduler: false,\n      pesanWA: text.toLowerCase().trim(),\n      targetNumber: remoteJid,\n    };\n  } catch (e) {\n    return {\n      isScheduler: true,\n      pesanWA: \"otomatis\",\n      targetNumber: \"\",\n    };\n  }\n}\n\nfunction formatPresensiList(kelasBelumAbsen) {\n  let text = \"🚨 *DAFTAR PRESENSI AKTIF:*\\n\\n\";\n\n  kelasBelumAbsen.forEach(m => {\n    text +=\n      `📚 *${m.MATA_KULIAH}*\\n` +\n      `⏳ Tutup: ${m.JAM_SELESAI}\\n\\n`;\n  });\n\n  text +=\n    \"Ketik:\\n\" +\n    \"/presensi hadir\\n\" +\n    \"/presensi hadir daring\\n\" +\n    \"/presensi sakit\\n\" +\n    \"/presensi izin\";\n\n  return text;\n}\n\n// ==============================\n// SOURCE\n// ==============================\nconst { isScheduler, pesanWA, targetNumber } = getWAData();\n\n// ==============================\n// DATA PRESENSI\n// ==============================\nconst presensiAktif = $input.first().json.data || [];\nconst kelasBelumAbsen = presensiAktif.filter(p => p.K_ABSENSI === \"\");\n\n// ==============================\n// SCHEDULER MODE\n// Scheduler cuma info, tidak execute\n// ==============================\nif (isScheduler) {\n  if (kelasBelumAbsen.length === 0) {\n    return [];\n  }\n\n  return {\n    json: {\n      action: \"INFORM_PRESENSI\",\n      status: \"ADA_PRESENSI\",\n      isScheduler: true,\n      text: formatPresensiList(kelasBelumAbsen),\n    }\n  };\n}\n\n// ==============================\n// MANUAL MODE: TIDAK ADA PRESENSI\n// ==============================\nif (presensiAktif.length === 0) {\n  return {\n    json: {\n      action: \"REPLY_ONLY\",\n      status: \"TIDAK_ADA_PRESENSI\",\n      isScheduler: false,\n      targetNumber,\n      text: \"Lagi gaada presensi kelas yang dibuka.\",\n    }\n  };\n}\n\n// ==============================\n// MANUAL MODE: SEMUA SUDAH ABSEN\n// ==============================\nif (kelasBelumAbsen.length === 0) {\n  return {\n    json: {\n      action: \"REPLY_ONLY\",\n      status: \"SUDAH_ABSEN_SEMUA\",\n      isScheduler: false,\n      targetNumber,\n      text: \"Kamu udah absen buat semua kelas yang aktif saat ini.\",\n    }\n  };\n}\n\n// ==============================\n// PARSE COMMAND\n// ==============================\nconst command = pesanWA.replace(\"/presensi\", \"\").trim();\n\nlet kode_absensi = \"\";\nlet is_daring = \"0\";\n\nif (command === \"\") {\n  return {\n    json: {\n      action: \"REPLY_ONLY\",\n      status: \"ADA_PRESENSI\",\n      isScheduler: false,\n      targetNumber,\n      text: formatPresensiList(kelasBelumAbsen),\n    }\n  };\n}\n\nif (command.includes(\"hadir daring\") || command.includes(\"hadir online\")) {\n  kode_absensi = \"H\";\n  is_daring = \"1\";\n}\nelse if (command.includes(\"hadir\") || command.includes(\"hadir luring\") || command.includes(\"hadir offline\")) {\n  kode_absensi = \"H\";\n  is_daring = \"0\";\n}\nelse if (command.includes(\"sakit\")) {\n  kode_absensi = \"S\";\n  is_daring = \"0\";\n}\nelse if (command.includes(\"izin\")) {\n  kode_absensi = \"I\";\n  is_daring = \"0\";\n}\n\n// ==============================\n// COMMAND INVALID\n// ==============================\nif (kode_absensi === \"\") {\n  return {\n    json: {\n      action: \"REPLY_ONLY\",\n      status: \"COMMAND_INVALID\",\n      isScheduler: false,\n      targetNumber,\n      text:\n        \"Command presensi belum dikenali.\\n\\n\" +\n        formatPresensiList(kelasBelumAbsen),\n    }\n  };\n}\n\n// ==============================\n// EXECUTE PRESENSI\n// Manual command only\n// ==============================\nreturn kelasBelumAbsen.map(matkul => ({\n  json: {\n    action: \"EXECUTE_PRESENSI\",\n    status: \"EXECUTE_PRESENSI\",\n    isScheduler: false,\n    targetNumber,\n    kode_materi: matkul.K_MATERI_AJAR,\n    kode_absensi,\n    is_daring,\n    nama_matkul: matkul.MATA_KULIAH,\n    text:\n      `Sedang execute presensi *${matkul.MATA_KULIAH}*...`,\n  }\n}));"
        },
