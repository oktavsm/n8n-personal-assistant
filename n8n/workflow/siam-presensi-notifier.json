    {
      "parameters": {
        "jsCode": "\nconst presensi = $input.item.json.data;\nconst itemsToSubmit = [];\n\nif (presensi && presensi.length > 0) {\n    presensi.forEach(p => {\n        if (p.IS_BUKA === \"1\" || p.IS_BUKA === 1) {\n            itemsToSubmit.push({\n                json: {\n                    matkul: p.MATA_KULIAH,\n                    kelas: p.KELAS,\n                    dosen: p.USERID,\n                    materi: p.MATERI,\n                    jam_selesai: p.JAM_SELESAI,\n                    K_MATERI_AJAR: p.K_MATERI_AJAR,\n                    IS_DARING: p.IS_DARING || '0'\n                }\n            });\n        }\n    });\n}\n\nreturn itemsToSubmit;\n"
      },
