    {
      "parameters": {
        "jsCode": "\nconst submitResults = $input.all();\nconst originalItems = $(\"Code in JavaScript\").all();\n\nlet textMsg = \"✅ *AUTO-ABSEN BERHASIL!* 🎉\\n\\n\";\n\nfor (let i = 0; i < submitResults.length; i++) {\n    const p = originalItems[i].json;\n    textMsg += \"📚 *\" + p.matkul + \" (Kelas \" + p.kelas + \")*\\n\";\n    textMsg += \"📝 Materi: \" + p.materi + \"\\n\\n\";\n}\n\ntextMsg += \"Santai aja bro, absen aman! 😎\";\n\nreturn { json: { text: textMsg } };\n"
      },
