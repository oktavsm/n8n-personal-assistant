      {
        "parameters": {
          "jsCode": "const panen = $input.item.json.data;\nlet textMsg = \"🎓 *Update Pengumuman SIAM*\\n\\n\";\n\n// Pakai try-catch buat nahan error kalau node WA Command nggak jalan\nlet command = \"\";\ntry {\n    command = $('WA Command').first().json.body.data.message.conversation || \"\";\n} catch (e) {\n    command = \"\"; \n}\n\nconst isScheduler = (command === \"\") ? true : false;\nconst todayString = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });\n\n// Static data untuk deduplikasi agar scheduler tidak spam setiap jam\nconst staticData = $getWorkflowStaticData('global');\nstaticData.sentAnnouncements = staticData.sentAnnouncements || [];\n\nif (panen && panen.length > 0) {\n    let adaPengumumanBaru = false;\n\n    panen.forEach(item => {\n        if (item.daftar_pengumuman && item.daftar_pengumuman.length > 0) {\n            const pengumumanFilter = item.daftar_pengumuman.filter(p => p.tanggal === todayString);\n            \n            // Kalau dari scheduler, hanya ambil yang belum pernah dikirim\n            // Kalau dari command WA, tampilkan semua pengumuman hari ini\n            const relevant = isScheduler \n                ? pengumumanFilter.filter(p => {\n                    const key = `${item.matkul}_${item.kelas}_${p.tanggal}_${p.isi.trim().slice(0, 40)}`;\n                    return !staticData.sentAnnouncements.includes(key);\n                  })\n                : pengumumanFilter;\n\n            if (relevant.length > 0) {\n                adaPengumumanBaru = true;\n                textMsg += `📚 *${item.matkul} (Kelas ${item.kelas})*\\n`;\n                \n                relevant.forEach(p => {\n                    textMsg += `🗓️ ${p.tanggal}\\n💬 _\"${p.isi.trim()}\"_\\n\\n`;\n                    if (isScheduler) {\n                        const key = `${item.matkul}_${item.kelas}_${p.tanggal}_${p.isi.trim().slice(0, 40)}`;\n                        staticData.sentAnnouncements.push(key);\n                    }\n                });\n                \n                textMsg += `〰️〰️〰️〰️〰️〰️\\n`;\n            }\n        }\n    });\n\n    // Batasi cache maksimal 150 item terakhir agar tidak membengkak\n    if (staticData.sentAnnouncements.length > 150) {\n        staticData.sentAnnouncements = staticData.sentAnnouncements.slice(-100);\n    }\n\n    if (!adaPengumumanBaru && !isScheduler) {\n        textMsg = `Gak ada pengumuman hari ini cok`;\n    } else if (isScheduler && !adaPengumumanBaru) {\n        textMsg = '';\n    }\n}\n\nreturn { \n    json: { \n        text: textMsg, \n        isScheduler \n    } \n};"
        },
