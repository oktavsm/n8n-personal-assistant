# PostgreSQL
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=notifier_db

# Brone / SIAM account (used by brone-auth workflows)
BRONE_USERNAME=your_brone_username
BRONE_PASSWORD=your_brone_password

# n8n
N8N_ENCRYPTION_KEY=replace_with_32_char_random_string
N8N_USER=your_n8n_email@example.com
N8N_PASSWORD=your_n8n_password
N8N_PORT=5679

# Evolution API
EVO_PORT=9001
WA_API_TOKEN=replace_with_your_api_token

# Docker log rotation (prevent host disk from filling)
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Gemini API key(s)
# If you use multiple keys, separate them with commas.
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# WhatsApp Identifiers & Whitelist
# ==========================================
MY_WA_NUMBER=628xxxxxxxxx
MANDA_WA_NUMBER=628xxxxxxxxx
WA_GROUP_DEV=xxxxxxxxxxxx@g.us
WA_GROUP_NOTIF=xxxxxxxxxxxx@g.us
WA_GROUP_SHARED=xxxxxxxxxxxx@g.us

# ==========================================
# Google Calendar IDs
# ==========================================
GCAL_OKTA_AGENDA=your_email@gmail.com
GCAL_OKTA_KULIAH=your_kuliah_id@group.calendar.google.com
GCAL_OKTA_TUGAS=your_tugas_id@group.calendar.google.com
GCAL_OKTA_UAS_SEM4=your_uas_id@group.calendar.google.com
GCAL_MANDA_AGENDA=partner_agenda_id@group.calendar.google.com
GCAL_MANDA_KULIAH=partner_kuliah_id@group.calendar.google.com
GCAL_MANDA_TUGAS=partner_tugas_id@group.calendar.google.com
GCAL_CLASS_KI=classroom_ki_id@group.calendar.google.com
GCAL_CLASS_PAW=classroom_paw_id@group.calendar.google.com
GCAL_CLASS_PAPB=classroom_papb_id@group.calendar.google.com
N8N_DEFAULT_ERROR_WORKFLOW=ERRnotif01UB2026
